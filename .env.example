# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL direto (memória do agente Alice) — normalmente a mesma instância do Supabase,
# usando a "Connection string" (modo "Session pooler" ou direto) do painel do Supabase
PG_MEMORY_URL=

# Segredo compartilhado entre Vercel Cron e Supabase pg_cron.
# Gere com `openssl rand -hex 32`; nunca reutilize senha de usuario ou banco.
CRON_SECRET=

# UazAPI — usada para envio de mensagens (chat individual e disparos/reativação)
UAZAPI_BASE_URL=

# URL publica do PDF de apresentacao do La Reserva, enviado pela tool enviar_pdf da Alice.
# Opcional — se em branco, usa o mesmo arquivo ja hospedado no Supabase Storage.
LA_RESERVA_PDF_URL=

# WhatsApp Business API (Meta) — mantido apenas para validação do webhook legado
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# N8N — repassa mensagens recebidas da Meta para o agente
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# OpenAI — agente Alice (chat) e geração de variações de mensagem dos disparos
OPENAI_API_KEY=
OPENAI_MODEL_ALICE=gpt-4.1-mini

# Disparos — no EasyPanel (onde o server.js customizado roda), deixe as três em branco:
# o motor de disparo e o Socket.io vivem no próprio processo.
#
# Na Vercel (serverless, não roda server.js), configure:
#   DISPARO_ENGINE_URL=https://<seu-app>.easypanel.host          (server-side; usada em next.config.ts
#                                                                  para encaminhar start/pause/stop ao EasyPanel)
#   NEXT_PUBLIC_DISPARO_SOCKET_URL=https://<seu-app>.easypanel.host (client-side; conecta o Socket.io
#                                                                     de progresso direto no EasyPanel)
DISPARO_ENGINE_URL=
NEXT_PUBLIC_DISPARO_SOCKET_URL=

# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=production
